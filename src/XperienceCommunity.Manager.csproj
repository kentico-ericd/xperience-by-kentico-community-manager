<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>xman</ToolCommandName>
		<PackageOutputPath>../dist</PackageOutputPath>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<TargetFramework>net10.0</TargetFramework>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<None Include="..\LICENSE" Pack="true" PackagePath="\" />
		<None Include="..\img\icon.png" Pack="true" PackagePath="" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Autofac" Version="9.3.4" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.2" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="nuget.protocol" Version="8.0.0" />
		<PackageReference Include="Spectre.Console" Version="0.57.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Scripts\**" />
	</ItemGroup>
</Project>
